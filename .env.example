# Optional local launcher configuration; process environment takes precedence.
# Generate distinct keys using the README commands. Missing keys fail closed.
# ADMIN_API_KEY=<generated key>
# OPERATOR_API_KEY=<different generated key>
TRUST_SKLEARN_ARTIFACTS=false
ENABLE_DEV_SWAGGER=false
APP_ENV=secure
# Local paths only; Compose uses its own mounted-volume paths.
DATABASE_URL=sqlite:///./model_serving.db
ARTIFACT_STORAGE_DIR=artifacts